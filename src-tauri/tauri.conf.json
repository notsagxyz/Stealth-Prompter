{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stealth",
  "version": "0.1.0",
  "identifier": "com.stealth.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Stealth",
        "url": "index.html",
        "width": 980,
        "height": 640,
        "minWidth": 740,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "center": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "prompter",
        "title": "Stealth HUD",
        "url": "hud.html",
        "width": 1000,
        "height": 350,
        "minWidth": 300,
        "minHeight": 150,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StealthPrompter",
  "version": "0.1.0",
  "identifier": "com.stealthprompter.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "StealthPrompter",
        "url": "index.html",
        "width": 900,
        "height": 650,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "center": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "prompter",
        "title": "StealthPrompter HUD",
        "url": "hud.html",
        "width": 1000,
        "height": 350,
        "minWidth": 300,
        "minHeight": 150,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  }
}
